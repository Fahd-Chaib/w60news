# Only needed to run the bot on your own computer (auth commands, local tests).
# On GitHub, put these values in: Settings → Secrets and variables → Actions.

# Free open-source LLM (gpt-oss-120b). Groq is used first, Cerebras takes over if Groq is busy.
GROQ_API_KEY=            # console.groq.com → API Keys (free, no card)
CEREBRAS_API_KEY=        # cloud.cerebras.ai → API Keys (free, optional backup)

# Free stock photos (pexels.com/api). Optional: without it, videos use generated backgrounds.
PEXELS_API_KEY=

# Encrypts refreshed tokens stored on the `state` branch. Generate with: python -m newsbot keygen
STATE_KEY=

# YouTube: path to the "OAuth client (Desktop app)" JSON, then run: python -m newsbot auth youtube
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_JSON=

# Instagram (Professional/Creator account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok (developers.tiktok.com → app with Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-USERNAME.github.io/YOUR-REPO/
TIKTOK_TOKEN_JSON=

# Voice engine: edge (free neural voices) | silent (offline tests)
TTS_BACKEND=edge
